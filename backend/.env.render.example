# ---- Render -> Web Service -> Environment Variables ----
# Render does NOT read this file at deploy time. It is a checklist: copy these
# keys into the Render dashboard (your service -> Environment). Never commit
# real secrets here.
#
# Leave PORT unset - Render injects it and the app reads process.env.PORT.

NODE_ENV=production
SERVE_FRONTEND=true

DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your-tidb-user
DB_PASSWORD=your-tidb-password
DB_NAME=elegai_dev
DB_SSL=true

JWT_SECRET=generate-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*

# ---- AI stylist ----
# With no key the built-in rule-based engine is used (recommendations still work,
# but no photo analysis). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-4o-mini

# ---- Image generation ----
# Gemini image models need billing enabled. Without paid keys the free renderer
# uses Pollinations (add a free token) then Stable Horde (anonymous key works).
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
POLLINATIONS_TOKEN=
HORDE_API_KEY=0000000000

# ---- Password-reset email ----
# Without these, production will NOT email reset codes. The admin can still
# generate a code per customer from Admin -> Customers and share it directly.
# For Gmail: enable 2FA -> create an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ElegAI <no-reply@elegai.com>

# ---- CAPTCHA ----
# Real keys must have the Render hostname added in Turnstile. The official test
# keys below always display and always pass, and need no hostname setup.
CAPTCHA_ENABLED=false
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Uploads ----
# Note: Render's filesystem is ephemeral, so uploaded images do not survive a
# redeploy/restart. Seeded catalog images are fine.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
