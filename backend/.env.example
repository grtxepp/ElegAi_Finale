# ---- ElegAI Backend Environment ----

# Server
PORT=5000
NODE_ENV=development
# Use a different strong random value (32+ characters) in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Email (password reset codes) ----
# Any SMTP provider works. For Gmail, create an App Password and use:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# Leave SMTP_USER/SMTP_PASS blank to disable email; in development the reset
# code is then returned in the API response instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ElegAI <no-reply@elegai.com>

# Cloudflare Turnstile CAPTCHA - development uses official test keys if blank.
# In production, set CAPTCHA_ENABLED=true and add your real secret key.
CAPTCHA_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=elegai
DB_PASSWORD=elegai_pass
DB_NAME=elegai
# Set true for cloud MySQL that requires TLS (e.g. TiDB Cloud Serverless, port 4000)
DB_SSL=false

# ---- AI Recommendation Service ----
# The provider is auto-detected in this order: gemini -> openai -> local.
#   * Set GEMINI_API_KEY to use Google Gemini (also enables photo analysis).
#   * Otherwise set OPENAI_API_KEY to use OpenAI GPT.
#   * With no keys set, the built-in "ElegAI Style Engine" (deterministic
#     rule-based recommendations over the product database) is used, so the
#     app is fully functional without any external API.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini

# Image generation (real providers). Gemini image models are a PAID feature -
# the free tier reports "limit: 0". Enable billing on the Google AI Studio
# project to use them; otherwise OpenAI gpt-image is tried, then the free
# no-key Flux renderer keeps the feature working.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Optional free Pollinations key (flux model is free). Get one at
# https://enter.pollinations.ai/keys - without it the free renderer is anonymous
# and heavily rate-limited.
POLLINATIONS_TOKEN=
# Stable Horde (aihorde.net) - free community GPU image generation, no signup.
# "0000000000" is the anonymous key. Register a free key at
# https://stablehorde.net/register for faster queues.
HORDE_API_KEY=0000000000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# CORS - comma separated origins, or * for all
CORS_ORIGIN=*
